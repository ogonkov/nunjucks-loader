{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "include": ["src/**/*.ts","src/**/*.js","test/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowJs": true,
    "typeRoots": ["./src/@types", "./node_modules/@types"],
  }
}
