{
  "name": "simple-nunjucks-loader",
  "version": "3.2.0",
  "description": "Webpack loader for Nunjucks",
  "main": "index.js",
  "files": [
    "lib",
    "public"
  ],
  "scripts": {
    "build:cjs": "babel src --env-name cjs --out-dir=. --copy-files --no-copy-ignored --ignore \"src/**/*.spec.js\"",
    "build:clean": "node contrib/clean-build.mjs",
    "build": "npm run build:clean && npm run build:cjs",
    "lint": "eslint .",
    "pretest": "node contrib/clean-build.mjs test/.coverage && npm run lint",
    "test": "jest",
    "posttest": "node contrib/clean-build.mjs test/bundles",
    "preversion": "./contrib/good-to-go.sh && npm test",
    "postversion": "git push && git push --tags",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogonkov/nunjucks-loader.git"
  },
  "keywords": [
    "webpack",
    "loader",
    "nunjucks",
    "template",
    "html-webpack-plugin"
  ],
  "author": "ogonkov <lesha.ogonkov@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ogonkov/nunjucks-loader/issues"
  },
  "homepage": "https://ogonkov.github.io/nunjucks-loader/",
  "dependencies": {
    "core-js": "^3.50.0"
  },
  "optionalDependencies": {
    "glob": "^13.0.6"
  },
  "peerDependencies": {
    "nunjucks": "^3.0.0",
    "webpack": "^5.27.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-dynamic-import": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "babel-jest": "^30.5.2",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nunjucks": "^3.2.4",
    "webpack": "^5.111.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
