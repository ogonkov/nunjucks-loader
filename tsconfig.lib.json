{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "node_modules/.tmp/tsbuild/lib",
    "tsBuildInfoFile": "node_modules/.tmp/tsbuild/lib.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/public"
  ],
  "references": [
    {
      "path": "./tsconfig.public.json"
    }
  ]
}
